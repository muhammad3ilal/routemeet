# Copy to deploy/.env.azure on the VM and fill in the blank values.
# Run Compose from the repository root with:
# docker compose --env-file deploy/.env.azure -f compose.azure.yaml up -d --build

# A DNS hostname pointing to the VM's public IP, without https:// or a path.
# An Azure public-IP DNS name works; a separately purchased domain is optional.
APP_DOMAIN=

# Public browser key: restrict it to https://your-hostname in MapTiler Cloud.
# Vite embeds this key in JavaScript; changing it requires an image rebuild.
VITE_MAPTILER_KEY=

# Server key: sent only by the backend. Never use it as a Docker build argument.
# If restricted by IP, allow the VM's actual outbound public IP.
MAPTILER_API_KEY=

# Public endpoints are for a small demo, with usage limits and no availability
# guarantee. Replace them with appropriate hosted or self-hosted services before
# inviting substantial traffic. These services do not provide live traffic.
OSRM_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Local daily safety budgets, not the providers' account or billing quotas.
MAP_MAX_REQUESTS_PER_DAY=200
MAP_MAX_MATRIX_ELEMENTS_PER_DAY=2000
